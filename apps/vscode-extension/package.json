{
  "name": "dbml-canvas-vscode",
  "displayName": "DBML Canvas",
  "description": "Preview DBML as a draggable ERD and save positions beside the schema file.",
  "version": "0.1.1",
  "publisher": "thinkgrowstudio",
  "license": "SEE LICENSE IN LICENSE",
  "icon": "icons/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/kchsoft/DBML-canvas.git",
    "directory": "apps/vscode-extension"
  },
  "engines": {
    "vscode": "^1.102.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onCommand:dbmlCanvas.openPreview"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dbmlCanvas",
          "title": "DBML Canvas",
          "icon": "resources/dbml-canvas.svg"
        }
      ]
    },

    "views": {
      "dbmlCanvas": [
        {
          "id": "dbmlCanvas.view",
          "name": "DBML Canvas",
          "type": "webview"
        }
      ]
    },
    "languages": [
      {
        "id": "dbml",
        "aliases": [
          "DBML",
          "dbml"
        ],
        "extensions": [
          ".dbml"
        ]
      }
    ],
    "commands": [
      {
        "command": "dbmlCanvas.openPreview",
        "title": "DBML Canvas: Open Preview"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "dbmlCanvas.openPreview",
          "when": "resourceExtname == .dbml",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "copy-webview": "node scripts/copy-webview.mjs",
    "build": "npm run copy-webview && node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build -w @dbml-canvas/host-webview && npm run build && node --import ./test/register-vscode-mock.mjs --test test/*.test.mjs",
    "package": "npm run build && node scripts/package.mjs package",
    "publish": "npm run build && node scripts/package.mjs publish"
  },
  "devDependencies": {
    "@dbml-canvas/core": "0.1.0",
    "@types/node": "^22.15.0",
    "@types/vscode": "^1.102.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.27.7"
  },
  "type": "module"
}
